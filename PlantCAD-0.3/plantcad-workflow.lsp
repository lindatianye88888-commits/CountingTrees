;;; 0.3.11: linked planting output. All metadata is persisted with the DWG.
(defun pl:fill-patterns () '("ANSI31" "ANSI32" "ANSI33" "ANSI34" "ANSI35" "ANSI36" "ANSI37" "ANSI38"))
(defun pl:fill-pattern-index (pattern / index found item)
  (setq index 0 found 0)
  (foreach item (pl:fill-patterns) (setq index (1+ index)) (if (equal item pattern) (setq found index))) found)
(defun pl:fill-pattern (p / pattern total c)
  (setq pattern (pl:get 'fill_pattern (pl:upgrade-plant p)))
  (if (member pattern (pl:fill-patterns)) pattern
    (progn
      (setq total 0)
      (foreach c (vl-string->list (pl:size-key p)) (setq total (+ total c)))
      (nth (rem total (length (pl:fill-patterns))) (pl:fill-patterns)))))
(defun pl:accept-fill-fields (/ size angle index)
  (setq size (pl:number-input (get_tile "fill_scale")) angle (pl:number-input (get_tile "fill_angle"))
    index (atoi (get_tile "fill_pattern")))
  (if (and size (> size 0) angle (>= angle 0) (< angle 360))
    (progn (setq pl:*fill-pattern* (if (= index 0) "" (nth (1- index) (pl:fill-patterns)))
      pl:*fill-scale* (/ size 100.0) pl:*fill-angle* angle) nil)
    "填充比例须大于0，角度范围为0至小于360度。"))
(defun pl:edit-name-choices (p / names species row index selected)
  (setq pl:*edit-choices* (list p) names (list (strcat "当前：" (pl:get 'name p))))
  (foreach species (pl:catalog)
    (setq row (pl:put 'species_id (pl:get 'id species)
      (pl:put 'name (pl:get 'name species) (pl:put 'kind (pl:species-kind (pl:get 'category species)) p))))
    (setq pl:*edit-choices* (append pl:*edit-choices* (list row)) names (append names (list (pl:get 'name species)))))
  (pl:popup "plant_choice" names) (set_tile "plant_choice" "0"))
(defun pl:edit-name-selected (value / p)
  (if (setq p (nth (atoi value) pl:*edit-choices*))
    (progn
      (setq pl:*edit* (pl:put 'species_id (pl:get 'species_id p) pl:*edit*))
      (set_tile "name" (pl:get 'name p))
      ;; Keep an explicitly chosen shrub-ball/flower-border/lawn role when changing species.
      (if (not (member (atoi (get_tile "kind")) '(3 4 5)))
        (set_tile "kind" (itoa (pl:get 'kind p)))))))
(defun pl:plant-label-layer (p)
  (cond ((= (pl:get 'kind p) 3) "PL_灌木球_标注") ((= (pl:get 'kind p) 4) "PL_花境_标注")
    ((= (pl:get 'kind p) 6) "PL_竹类_标注")
    ((member (pl:get 'kind p) '(2 5)) "PL_草地_标注") ((= (pl:get 'kind p) 1) "PL_灌木_标注")
    (T "PL_标注_树木")))
(defun pl:area-label-layer (e / p)
  (if (setq p (pl:data-get e "AREA_PLANT")) (pl:plant-label-layer p) "PL_标注_区域"))
(defun pl:fill-layer (p)
  (cond ((= (pl:get 'kind p) 4) "PL_花境_填充") ((member (pl:get 'kind p) '(2 5)) "PL_草地_填充")
    (T "PL_灌木_填充")))
(defun pl:fill-area (e / p signature state saved result)
  (if (and (boundp 'pl:*native-ui*) pl:*native-ui* (setq p (pl:data-get e "AREA_PLANT")) (pl:area-value e))
    (progn
      (setq p (pl:upgrade-plant p) signature (pl:native-value (pl:native-area-signature (cdr (assoc 5 (entget e)))))
        state (list (pl:fill-pattern p) (* (pl:get 'fill_scale p) (pl:data-get e "UNITS"))
          (* pi (/ (pl:get 'fill_angle p) 180.0)) (pl:fill-layer p) signature)
        saved (pl:data-get e "FILL_HANDLE"))
      (if (or (not (equal state (pl:data-get e "FILL_STATE"))) (not saved) (not (handent saved)))
        (progn
          (setq result (pl:native-value (pl:native-fill (cdr (assoc 5 (entget e))) (nth 0 state) (nth 1 state) (nth 2 state) (nth 3 state))))
          (if (or (/= (type result) 'STR) (= (substr result 1 6) "ERROR:"))
            (pl:fail (strcat "区域填充失败：" (if (= (type result) 'STR) result "没有返回图案"))))
          (pl:data-put e "FILL_STATE" state) (pl:data-put e "FILL_HANDLE" result))) T)))
(defun pl:selected-areas (/ selection item e result)
  (setq selection (ssget "_I" '((-3 ("PLANTCAD01")))))
  (if (not selection) (progn (princ "\n选择已算面积、面积文字或填充，可多选，回车确认：")
    (setq selection (ssget '((-3 ("PLANTCAD01")))))))
  (sssetfirst nil nil)
  (foreach item (pl:ss-list selection)
    (if (and (setq e (pl:area-from-selection item)) (not (member e result))) (setq result (append result (list e))))) result)
(defun pl:fill-work (/ areas p e n)
  (pl:init-layers)
  (setq areas (pl:selected-areas) n 0)
  (if areas
    (progn
      (if (not (pl:current)) (pl:library-work))
      (if (setq p (pl:current))
        (foreach e areas (if (pl:bind-area-plant e p) (setq n (1+ n)))))
      (princ (strcat "\n按当前植物种类填充 " (itoa n) " 个区域；可在规格中选用重复图案。")))))
(defun pl:placement-menu-work (/ choice)
  (initget "Point Ball Line Grid Fill Label Scan")
  (setq choice (getkword "\n开始布置 [单株(Point)/灌木球(Ball)/沿线(Line)/网格(Grid)/面积填充(Fill)/引线标注(Label)/扫描面积(Scan)] <Point>："))
  (cond ((= choice "Ball") (pl:ball-work)) ((= choice "Line") (pl:line-work)) ((= choice "Grid") (pl:grid-work))
    ((= choice "Fill") (pl:fill-work)) ((= choice "Label") (pl:output-area-work)) ((= choice "Scan") (pl:geometry-area-work)) (T (pl:insert-work))))
(defun pl:ball-work (/ p)
  (if (not (pl:current)) (pl:design-start))
  (if (setq p (pl:current))
    (progn
      (if (/= (pl:get 'kind p) 3)
        (progn
          (setq p (pl:put 'kind 3 (pl:put 'id (pl:new-id) (pl:put 'spec_no (pl:next-spec-number (pl:used-specs)) p))))
          (if (<= (pl:get 'crown p) 0) (setq p (pl:put 'crown 1.0 p)))
          (pl:save-def p) (pl:db-put "CURRENT" (pl:get 'id p))))
      (pl:insert-work))))

;;; Project edits update the existing specification; single-instance editing still creates variants.
(defun pl:edit-project-dialog (p / result)
  (setq pl:*project-edit* T)
  (setq result (vl-catch-all-apply 'pl:edit-dialog (list p)))
  (setq pl:*project-edit* nil)
  (if (vl-catch-all-error-p result) (pl:rethrow result) result))
(defun pl:save-project-spec (p / defs old history row kept e source)
  (setq defs (pl:defs) old (pl:by-id (pl:get 'id p)))
  (if (not old) (pl:save-def p)
    (progn
      (if (pl:plant-error p) (pl:fail (pl:plant-error p)))
      (if (pl:spec-error p (pl:used-specs)) (pl:fail (pl:spec-error p (pl:used-specs))))
      ;; Check all affected layers before committing the changed definition.
      (foreach e (append (pl:all-trees) (pl:all-areas))
        (setq source (if (equal (pl:role e) "AREA") (pl:data-get e "AREA_PLANT") (pl:plant e)))
        (if (and source (= (pl:get 'id source) (pl:get 'id p)))
          (progn
            (if (not (pl:writable e)) (pl:fail "该规格的图上对象图层已锁定，请解锁后再改项目规格。"))
            (if (pl:layer-issue (pl:plant-label-layer p)) (pl:fail (pl:layer-issue (pl:plant-label-layer p))))
            (if (pl:plant e)
              (progn
                (if (pl:insert-error p) (pl:fail (pl:insert-error p)))
                (if (pl:layer-issue (pl:tree-layer p)) (pl:fail (pl:layer-issue (pl:tree-layer p)))))
              (if (pl:layer-issue (pl:fill-layer p)) (pl:fail (pl:layer-issue (pl:fill-layer p))))))))
      (foreach e (pl:ss-list (ssget "_X" '((-3 ("PLANTCAD01")))))
        (if (and (not (pl:writable e))
          (or (equal (pl:role e) "TABLE")
            (and (setq source (pl:source e)) (setq source (pl:annotation-plant source))
              (= (pl:get 'id source) (pl:get 'id p)))))
          (pl:fail "该规格有关联标注、填充或表格图层锁定，请先解锁。")))
      (pl:db-put "PLANTS" (subst p old defs))
      (setq history (pl:db-get "SPEC_HISTORY" nil) kept nil)
      (foreach row history
        (if (/= (pl:get 'id row) (pl:get 'id p)) (setq kept (append kept (list row)))))
      (pl:db-put "SPEC_HISTORY" (append kept (list p))) (pl:remember-size p)
      (pl:built-blocks)
      (foreach e (pl:all-trees)
        (if (= (pl:get 'id (pl:plant e)) (pl:get 'id p))
          (if (not (pl:apply-plant e p)) (pl:fail "项目规格已修改，但图例更新失败；可用U撤销本次修改。"))))
      (foreach e (pl:all-areas)
        (if (and (setq row (pl:data-get e "AREA_PLANT")) (= (pl:get 'id row) (pl:get 'id p)))
          (progn (pl:data-put e "AREA_PLANT" p) (pl:fill-area e)))))) p)

;;; Output leader options are stored per annotation, preserving the selected layout on refresh.
(defun pl:output-area-text (e options / area title)
  (if (setq area (pl:area-value e))
    (progn
      (setq title (pl:mtext-safe (pl:area-title e)))
      (strcat title (if (= (pl:get 'layout options) 1) "  " "\\P")
        (if (equal (pl:data-get e "AREA_REPAIRED") 1) "约 " "")
        (pl:area-text area) " 平方米" (if (equal (pl:data-get e "AREA_REPAIRED") 1) "（补线推定）" "")))))
(defun pl:area-output-options (/ id saved status)
  (setq saved (pl:db-get "AREA_OUTPUT_OPTIONS" '((layout . 0) (fill . 1) (bind . 0)))
    id (pl:dialog "pl_area_output") pl:*area-output-result* nil)
  (if id
    (progn
      (pl:popup "area_layout" '("上行植物、下行面积（引线横线居中）" "植物在前、面积在后（同在横线上方）"))
      (set_tile "area_layout" (itoa (pl:get 'layout saved)))
      (set_tile "area_fill" (itoa (pl:get 'fill saved))) (set_tile "area_bind" (itoa (pl:get 'bind saved)))
      (action_tile "accept" "(setq pl:*area-output-result* (list (cons 'layout (atoi (get_tile \"area_layout\"))) (cons 'fill (atoi (get_tile \"area_fill\"))) (cons 'bind (atoi (get_tile \"area_bind\"))))) (done_dialog 1)")
      (action_tile "cancel" "(done_dialog 0)")
      (setq status (start_dialog)) (unload_dialog id)
      (if (= status 1) (progn (pl:db-put "AREA_OUTPUT_OPTIONS" pl:*area-output-result*) pl:*area-output-result*) nil))))
(defun pl:area-output-linked (area / result e)
  (foreach e (pl:ss-list (ssget "_X" '((-3 ("PLANTCAD01")))))
    (if (and (member (pl:role e) '("AREA_LABEL" "AREA_LEADER" "AREA_ARROW")) (equal (pl:source e) area))
      (setq result (cons e result)))) result)
(defun pl:output-leader-shape (label / area point anchor height width elbow end line arrow layer direction side a b c old text split columns)
  (setq area (pl:source label) point (cdr (assoc 10 (entget label))) anchor (pl:data-get label "ANCHOR")
    height (cdr (assoc 40 (entget label))) layer (pl:area-label-layer area)
    text (cdr (assoc 1 (entget label))) split (vl-string-search "\\P" text)
    columns (if split (max split (- (strlen text) split 2)) (strlen text))
    width (* height 0.55 (max 12 columns)))
  (setq elbow (list (- (car point) (* 2 height)) (cadr point) (caddr point))
    end (list (+ (car point) width) (cadr point) (caddr point)))
  (foreach old (pl:area-output-linked area)
    (if (and (member (pl:role old) '("AREA_LEADER" "AREA_ARROW")) (pl:writable old)) (entdel old)))
  (setq line (pl:make (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 layer) '(62 . 256)
    '(100 . "AcDbPolyline") '(90 . 3) '(70 . 0) (cons 38 (caddr point))
    (cons 10 (list (car anchor) (cadr anchor))) (cons 10 (list (car elbow) (cadr elbow))) (cons 10 (list (car end) (cadr end))))))
  (pl:mark line "AREA_LEADER" (cdr (assoc 5 (entget area))))
  (setq direction (angle anchor elbow) side (* height 0.3)
    a anchor b (polar anchor (+ direction 0.25) side) c (polar anchor (- direction 0.25) side))
  (setq arrow (pl:make (list '(0 . "SOLID") (cons 8 layer) '(62 . 256) (cons 10 a) (cons 11 b) (cons 12 c) (cons 13 c))))
  (pl:mark arrow "AREA_ARROW" (cdr (assoc 5 (entget area))))
  (pl:data-put label "LEADER_POSITION" point)
  (pl:data-put label "LEADER_STATE" (list point text height layer)))
(defun pl:write-native-area-label (e anchor point options existing height / result label args)
  (if (not height) (setq height (pl:plot-text-height e)))
  (setq args (list
    (if existing (cdr (assoc 5 (entget existing))) "") (cdr (assoc 5 (entget e)))
    anchor point (pl:output-area-text e options) height (pl:area-label-layer e) (pl:get 'layout options)))
  (if (pl:get 'elbow options) (setq args (append args (list (pl:get 'elbow options)))))
  (setq result (pl:native-value (apply 'pl:native-area-leader args)))
  (if (or (/= (type result) 'STR) (= (substr result 1 6) "ERROR:"))
    (pl:fail (strcat "整体引线生成失败：" (if (= (type result) 'STR) result "没有返回标注"))))
  (setq label (handent result))
  (pl:data-put label "OUTPUT_OPTIONS" options) (pl:data-put label "ANCHOR" anchor)
  (pl:data-put label "OUTPUT_STYLE_VERSION" 3)
  (pl:data-put label "OUTPUT_HEIGHT" height) (pl:data-put label "AREA_LABEL_TEXT" (pl:output-area-text e options)) label)
(defun pl:area-annotation-height (e output) (pl:plot-text-height e))
(defun pl:output-area-label (e anchor point options / old item label)
  (if (and (boundp 'pl:*native-ui*) pl:*native-ui*)
    (progn
      (setq old (pl:area-output-linked e))
      (foreach item old (if (not (pl:writable item)) (pl:fail "原面积标注图层已锁定，请先解锁。")))
      (setq label (pl:write-native-area-label e anchor point options nil nil))
      (foreach item old (entdel item)) label)
    (pl:legacy-output-area-label e anchor point options)))
(defun pl:legacy-output-area-label (e anchor point options / height label old item layer text)
  (setq layer (pl:area-label-layer e) old (pl:area-output-linked e))
  (if (pl:layer-issue layer) (pl:fail (pl:layer-issue layer)))
  (foreach item old (if (not (pl:writable item)) (pl:fail "原面积标注图层已锁定，请先解锁。")))
  (setq height (pl:plot-text-height e)
    text (pl:output-area-text e options))
  (setq label (pl:make (list '(0 . "MTEXT") '(100 . "AcDbEntity") (cons 8 layer) '(62 . 256)
    '(100 . "AcDbMText") (cons 10 point) (cons 40 height) '(41 . 0.0)
    (cons 71 (if (= (pl:get 'layout options) 1) 7 4)) '(72 . 1) (cons 1 text) (cons 7 (getvar "TEXTSTYLE")))))
  (pl:mark label "AREA_LABEL" (cdr (assoc 5 (entget e))))
  (pl:data-put label "OUTPUT_OPTIONS" options) (pl:data-put label "ANCHOR" anchor)
  (foreach item old (entdel item))
  (pl:output-leader-shape label) label)
(defun pl:try-fill-area (e / result previous reason)
  (setq previous pl:*failure* pl:*failure* nil result (vl-catch-all-apply 'pl:fill-area (list e)))
  (if (vl-catch-all-error-p result)
    (progn
      (setq reason (if pl:*failure* pl:*failure* (vl-catch-all-error-message result)))
      (princ (strcat "\n区域 " (pl:area-number e) " 的填充未完成：" reason "；已生成的引线和文字保留。"))))
  (setq pl:*failure* previous)
  (not (vl-catch-all-error-p result)))
(defun pl:upgrade-area-leaders (/ label source options old safe item n)
  (setq n 0)
  (if (and (boundp 'pl:*native-ui*) pl:*native-ui*)
    (foreach label (pl:all-labels)
      (if (and (= (cdr (assoc 0 (entget label))) "MTEXT") (equal (pl:role label) "AREA_LABEL")
        (setq options (pl:data-get label "OUTPUT_OPTIONS")) (setq source (pl:source label)) (entget source)
        (pl:data-get label "ANCHOR"))
        (progn
          (setq old (pl:area-output-linked source) safe T)
          (foreach item old (if (not (pl:writable item)) (setq safe nil)))
          (if safe
            (progn
              (pl:write-native-area-label source (pl:data-get label "ANCHOR")
                (cdr (assoc 10 (entget label))) options nil (pl:plot-text-height source))
              (foreach item old (entdel item)) (setq n (1+ n)))))))) n)
(defun pl:area-label-name (e name / matches p kind)
  (setq name (pl:trim name))
  (if (/= name "")
    (progn
      (setq matches (pl:label-plant-matches (list name) (pl:defs)))
      (cond
        ((= (length matches) 1) (setq p (car matches)))
        ((> (length matches) 1) (princ "\n此名称有多个规格，请输入唯一的规格编号，或从项目规格选择。"))
        (T
          (setq kind (pl:data-get e "AREA_KIND") p (pl:empty-plant (pl:new-id)))
          (setq p (pl:put 'name name (pl:put 'kind (if (member kind '(1 2 4 5)) kind 1)
            (pl:put 'quantity_unit "平方米" (pl:put 'spec_no (pl:next-spec-number (pl:used-specs)) p)))))
          (pl:save-def p)))
      (if p (pl:data-put e "AREA_PLANT" p)))) p)
(defun pl:area-annotation-raw (label)
  (if (= (cdr (assoc 0 (entget label))) "MULTILEADER")
    (pl:native-value (pl:native-leader-text (cdr (assoc 5 (entget label)))) ) (cdr (assoc 1 (entget label)))))
(defun pl:area-label-name-edits (/ edits label area raw baseline expected name pair matches)
  (foreach label (pl:all-labels)
    (if (and (equal (pl:role label) "AREA_LABEL") (setq area (pl:source label)) (entget area)
      (setq raw (pl:area-annotation-raw label)))
      (progn
        (setq baseline (pl:data-get label "AREA_LABEL_TEXT")
          expected (if (pl:data-get label "OUTPUT_OPTIONS") (pl:output-area-text area (pl:data-get label "OUTPUT_OPTIONS")) (pl:area-label-text area)))
        (if (not (equal raw (if baseline baseline expected)))
          (progn
            (setq name (pl:native-value (pl:native-area-label-name (cdr (assoc 5 (entget label))))))
            (if (and (= (type name) 'STR) (= (substr name 1 6) "ERROR:")) (pl:fail name))
            (if (and name (/= name "") (not (equal (pl:normal-name name) (pl:normal-name (pl:area-title area)))))
              (progn
                (if (or (not (pl:writable area)) (not (pl:writable label))) (pl:fail "改名区域或标注图层锁定，请先解锁。"))
                (setq matches (pl:label-plant-matches (list name) (pl:defs)) pair (assoc area edits))
                (if (> (length matches) 1) (pl:fail "改后的灌木名称对应多个规格，请输入唯一规格编号，或在项目规格明确选择后关联。"))
                (if (and pair (not (equal name (cadr pair)))) (pl:fail "同一区域的多条标注改成了不同植物，请先统一名称。"))
                (if (not pair) (setq edits (append edits (list (list area name)))))))))))) edits)
(defun pl:import-area-label-edits (/ edits pair count)
  ;; Direct CAD text edits are imported on explicit sync/statistics, never from reactors.
  ;; A project/specification change takes precedence over an old label's displayed text.
  (if (and (boundp 'pl:*native-ui*) pl:*native-ui* (not pl:*drawing-changed*))
    (progn
      (setq edits (pl:area-label-name-edits) count 0)
      (foreach pair edits
        (if (pl:area-label-name (car pair) (cadr pair)) (setq count (1+ count))
          (pl:fail "灌木名称未能关联，请在项目规格中选定后重新关联。")))
      (if (> count 0) (princ (strcat "\n已识别 " (itoa count) " 个直接修改的灌木名称，面积继续按边界计算。"))) count)))
(defun pl:area-label-geometry (e anchor / elbow tail valid)
  (if (setq elbow (getpoint (trans anchor 0 1)
    (strcat "\n" (pl:area-number e) " 第一点：指定引线折点（回车跳过）：")))
    (progn
      (setq elbow (trans elbow 1 0))
      (while (and (not valid) (setq tail (getpoint (trans elbow 0 1)
        "\n第二点：指定横线尾端，向左或向右（与折点保持水平；回车跳过）：")))
        (setq tail (trans tail 1 0))
        (if (< (abs (- (car elbow) (car tail))) 1.0e-8)
          (princ "\n横线尾端须在折点左侧或右侧，请重新点选。")
          (setq valid T tail (list (car tail) (cadr elbow) (caddr elbow)))))
      (if valid (list elbow tail)))))
(defun pl:area-species-filter (/ p)
  (setq pl:*area-species-visible* (pl:project-filter (pl:defs) -1 (get_tile "area_query"))
    pl:*area-species-picked* nil)
  (start_list "area_columns") (add_list (pl:project-columns)) (end_list)
  (start_list "area_plants")
  (foreach p pl:*area-species-visible* (add_list (pl:project-list-row p))) (end_list))
(defun pl:area-species-row (value)
  (if (setq pl:*area-species-picked* (nth (atoi value) pl:*area-species-visible*))
    (set_tile "area_name" (pl:get 'name pl:*area-species-picked*))))
(defun pl:area-species-accept (/ name p matches)
  (setq name (pl:trim (get_tile "area_name")) p pl:*area-species-picked*)
  (if (and p (not (equal (pl:normal-name name) (pl:normal-name (pl:get 'name p))))) (setq p nil))
  (if (not p) (setq matches (pl:label-plant-matches (list name) (pl:defs))))
  (cond
    ((= name "") (alert "请选择项目品种，或输入植物名称。"))
    ((and (not p) (> (length matches) 1)) (alert "同名植物有多个规格，请在列表中选择具体规格，或输入唯一的规格编号。"))
    (T
      (if (and (not p) matches) (setq p (car matches)))
      (setq pl:*area-species-result* (if p (list "plant" p) (list "name" name))) (done_dialog 1))))
(defun pl:area-output-plant (e initial / id status quit p index row result)
  (setq p initial quit nil result nil)
  (while (not quit)
    (setq id (pl:dialog "pl_area_species") pl:*area-species-result* nil)
    (if (not id) (setq quit T)
      (progn
        (set_tile "area_query" "") (set_tile "area_name" (if p (pl:get 'name p) ""))
        (pl:area-species-filter)
        (setq pl:*area-species-picked* p index 0)
        (foreach row pl:*area-species-visible*
          (if (and p (equal (pl:get 'id row) (pl:get 'id p)))
            (progn (set_tile "area_plants" (itoa index)) (setq pl:*area-species-picked* row)))
          (setq index (1+ index)))
        (action_tile "area_query" "(pl:area-species-filter)")
        (action_tile "area_search" "(pl:area-species-filter)")
        (action_tile "area_plants" "(pl:area-species-row $value)")
        (action_tile "area_add" "(done_dialog 2)")
        (action_tile "accept" "(pl:area-species-accept)") (action_tile "cancel" "(done_dialog 0)")
        (setq status (start_dialog)) (unload_dialog id)
        (cond ((= status 2) (pl:add-from-catalog))
          ((= status 1) (setq result pl:*area-species-result* quit T)) (T (setq quit T))))))
  (if result (if (= (car result) "plant") (cadr result) (pl:area-label-name e (cadr result)))))
(defun pl:output-area-work (/ areas options p e anchor geometry chosen)
  (pl:import-area-label-edits)
  (pl:init-layers)
  (setq areas (pl:selected-areas))
  (if (and areas (setq options (pl:area-output-options)))
    (progn
      (setq p (pl:current))
      (foreach e areas
        (setq anchor (pl:data-get e "AREA_ANCHOR"))
        (if (not anchor)
          (if (setq anchor (getpoint "\n点选该区域内的引线起点：")) (setq anchor (trans anchor 1 0))))
        (if (and anchor (setq geometry (pl:area-label-geometry e anchor))
          (setq chosen (pl:area-output-plant e
            (if (or (= (pl:get 'bind options) 1) (not (pl:data-get e "AREA_PLANT"))) p (pl:data-get e "AREA_PLANT")))))
          (progn
            (setq p chosen) (pl:data-put e "AREA_PLANT" p) (pl:db-put "CURRENT" (pl:get 'id p))
            (pl:output-area-label e anchor (cadr geometry) (pl:put 'elbow (car geometry) options))
            (if (= (pl:get 'fill options) 1) (pl:try-fill-area e))))))))

;;; All three schedule types are native, linked ACAD_TABLE entities with block legends.
(defun pl:output-table-headers () '("编号" "图例" "植物名称" "类别" "胸径 cm" "地径 cm" "高度 cm" "冠幅 cm" "数量/面积" "单位"))
(defun pl:table-display-row (row)
  (append (list (car row) (nth 9 row)) (reverse (cdr (reverse (cdr row))))))
(defun pl:table-category (p)
  (cond ((member (pl:get 'kind p) '(0 6)) "trees") ((= (pl:get 'kind p) 3) "balls") (T "cover")))
(defun pl:table-category-title (group)
  (cond ((equal group "trees") "乔木、竹类") ((equal group "balls") "灌木球") (T "灌木地被（含花境、草坪）")))
(defun pl:table-species-key (p / id)
  (setq id (pl:get 'species_id p))
  (if (and id (/= id "")) (strcat "ID:" id) (strcat "NAME:" (pl:normal-name (pl:get 'name p)))))
(defun pl:table-record-matches (p scope)
  (and (or (not (pl:get 'category scope)) (equal (pl:get 'category scope) (pl:table-category p)))
    (or (not (pl:get 'species_key scope)) (equal (pl:get 'species_key scope) (pl:table-species-key p))
      (and (= (substr (pl:get 'species_key scope) 1 5) "NAME:")
        (or (not (pl:get 'species_id p)) (= (pl:get 'species_id p) ""))
        (member (pl:get 'id p) (pl:get 'species_specs scope))))))
(defun pl:table-species-scope (p records scope / key ids row id)
  (setq key (pl:table-species-key p))
  (foreach row records
    (if (and (equal key (pl:table-species-key (car row))) (setq id (pl:get 'id (car row))) (not (member id ids)))
      (setq ids (append ids (list id)))))
  (pl:put 'species_specs ids (pl:put 'species_key key scope)))
(defun pl:output-table-objects (scope / result h e)
  (if (= (pl:get 'scope scope) "model") (pl:statistics-model)
    (progn
      (foreach h (pl:get 'handles scope)
        (if (and (setq e (handent h)) (or (pl:quantity-data e) (equal (pl:role e) "PROJECT_SOURCE"))) (setq result (append result (list e))))) result)))
(defun pl:output-table-records (kind scope / result row p counts records)
  (if (and (boundp 'pl:*split-kind*) (equal kind pl:*split-kind*))
    (setq records pl:*split-records*)
    (if (= kind "count")
      (progn (setq counts (pl:output-counts scope))
        (foreach row counts (setq records (append records (list (list (cadr row) (caddr row))))))
        (setq records (append records (pl:project-pending-records (pl:output-table-objects scope) counts))))
      (foreach p (pl:ai-visible-defs)
        (setq records (append records (list (list p nil)))))))
  (foreach row records (if (pl:table-record-matches (car row) scope) (setq result (append result (list row))))) (pl:sort-plant-records result))
(defun pl:output-table-cells (record / p quantity legend)
  (setq p (car record) quantity (cadr record))
  (setq legend (if (or (= (pl:get 'quantity_unit p) "平方米") (and (null quantity) (pl:area-kind-p (pl:get 'kind p))))
    (strcat "HATCH:" (pl:fill-pattern p)) (pl:block-name p)))
  (list (pl:get 'spec_no p) (pl:get 'name p) (pl:kind-name (pl:get 'kind p))
    (pl:dimension-text 'dbh p) (pl:dimension-text 'caliper p) (pl:dimension-text 'height p) (pl:dimension-text 'crown p)
    (if quantity (pl:quantity-text p quantity) (if (equal (nth 2 record) "pending") "待关联" "")) (pl:get 'quantity_unit p) legend))
(defun pl:table-legend-layout (p / plot scale height values diameter spec)
  (setq plot (pl:plot-options)
    scale (pl:block-scale p 1.0))
  (if (<= scale 0) (setq scale 1.0))
  (setq height (/ (pl:paper-height (pl:get 'paper_height plot) (pl:get 'scale plot) 1.0) scale)
    values (pl:symbol-attribute "PL_DIAMETER" p '(0.0 0.0 0.0) height plot)
    diameter (if (caddr values) "" (car values))
    values (pl:symbol-attribute "PL_SPEC" p '(0.0 0.0 0.0) height plot)
    spec (if (caddr values) "" (car values)))
  (list height (pl:get 'kind p) (pl:get 'name p) diameter spec))
(defun pl:output-table-write (e point layer kind title height scope / records cells snapshot layouts record result)
  (pl:built-blocks)
  (setq records (pl:output-table-records kind scope))
  (foreach record records
    (setq cells (append cells (list (pl:table-display-row (pl:output-table-cells record))))
      snapshot (append snapshot (list (list (pl:get 'id (car record)) (pl:output-table-cells record))))
      layouts (append layouts (list (pl:table-legend-layout (car record))))))
  (setq result (pl:native-value (pl:native-table-write (if e (cdr (assoc 5 (entget e))) "") point layer title height (pl:output-table-headers) cells layouts)))
  (if (or (/= (type result) 'STR) (= (substr result 1 6) "ERROR:"))
    (pl:fail (strcat "关联表更新失败：" (if (= (type result) 'STR) result "没有返回表格"))))
  (setq e (handent result))
  (pl:data-put e "TABLE_KIND" kind) (pl:data-put e "TABLE_TITLE" title) (pl:data-put e "TABLE_HEIGHT" height)
  (pl:data-put e "TABLE_SCOPE" scope) (pl:data-put e "TABLE_ROWS" snapshot)
  (pl:data-put e "TABLE_LEGENDS" layouts) (pl:data-put e "TABLE_FORMAT" 4) e)
(defun pl:output-table-create (layer kind title / height point plot scope)
  (pl:init-layers)
  (if (not (and (boundp 'pl:*native-ui*) pl:*native-ui*)) (pl:fail "带图例的关联表需要配套原生插件，请从CountingTrees（数树）浮窗使用。"))
  (if (pl:require-units)
    (progn
      (setq plot (pl:plot-options)
        height (pl:paper-height (pl:get 'paper_height plot) (if (and (= (getvar "TILEMODE") 0) (= (getvar "CVPORT") 1)) 1.0 (pl:get 'scale plot)) (pl:units)))
      (if (setq point (getpoint (strcat "\n" title "插入点（原生关联表，带图例与编号）：")))
        (progn
          (setq scope (if (= kind "count") (pl:db-get "LAST_COUNT_SCOPE" '((scope . "model"))) '((scope . "model"))))
          (pl:output-table-write nil (trans point 1 0) layer kind title height scope)
          (princ "\n已生成关联表。项目规格修改自动关联；直接编辑表格后，请执行“更新关联标注”同步。"))))))
(defun pl:output-table-refresh (e / kind scope records snapshot layouts record title)
  (setq kind (pl:data-get e "TABLE_KIND") scope (pl:data-get e "TABLE_SCOPE") records (pl:output-table-records kind scope))
  (foreach record records (setq snapshot (append snapshot (list (list (pl:get 'id (car record)) (pl:output-table-cells record))))
    layouts (append layouts (list (pl:table-legend-layout (car record))))))
  (setq title (pl:data-get e "TABLE_TITLE"))
  (if (and (equal kind "count") (equal (pl:get 'scope scope) "model") (not (pl:get 'category scope)) (not (pl:get 'species_key scope)))
    (setq title "苗木数量总表"))
  (if (and (pl:get 'species_key scope) records) (setq title (strcat (pl:get 'name (caar records)) " · " (pl:table-kind-title kind))))
  (if (or (not (equal snapshot (pl:data-get e "TABLE_ROWS"))) (not (equal (pl:data-get e "TABLE_FORMAT") 4))
    (not (equal layouts (pl:data-get e "TABLE_LEGENDS")))
    (not (equal title (pl:data-get e "TABLE_TITLE"))))
    (pl:output-table-write e '(0.0 0.0 0.0) (cdr (assoc 8 (entget e))) kind title (pl:data-get e "TABLE_HEIGHT") scope)))
(defun pl:table-kind-title (kind)
  (cond ((equal kind "count") "苗木数量总表") ((equal kind "list") "植物名录表") (T "植物规格表")))
(defun pl:table-split-groups (records mode scope / groups category row p key seen filtered)
  (if (equal mode "category")
    (foreach category '("trees" "balls" "cover")
      (setq filtered nil)
      (foreach row records (if (equal (pl:table-category (car row)) category) (setq filtered T)))
      (if filtered (setq groups (append groups (list (list (pl:table-category-title category) (pl:put 'category category scope)))))))
    (foreach row records
      (setq p (car row) key (pl:table-species-key p))
      (if (not (member key seen))
        (setq seen (cons key seen) groups (append groups (list (list (pl:get 'name p) (pl:table-species-scope p records scope)))))))) groups)
(defun pl:output-tables-split (source layer kind scope mode / groups point height plot group table result records pl:*split-kind* pl:*split-records*)
  (pl:init-layers)
  (if (not (and (boundp 'pl:*native-ui*) pl:*native-ui*)) (pl:fail "分类关联表需要配套原生插件。"))
  (if (pl:require-units)
    (progn
      (setq records (pl:output-table-records kind scope) groups (pl:table-split-groups records mode scope)
        pl:*split-kind* kind pl:*split-records* records)
      (if (not groups) (princ "\n此范围没有可拆分的植物记录。")
        (if (setq point (getpoint "\n指定第一张表的左上角，各表自动向下排列（回车取消）："))
          (progn
            (setq point (trans point 1 0) height (if source (pl:data-get source "TABLE_HEIGHT")))
            (if (not height)
              (progn (setq plot (pl:plot-options))
                (setq height (pl:paper-height (pl:get 'paper_height plot)
                  (if (and (= (getvar "TILEMODE") 0) (= (getvar "CVPORT") 1)) 1.0 (pl:get 'scale plot)) (pl:units)))))
            (foreach group groups
              (setq table (pl:output-table-write nil point layer kind (strcat (car group) " · " (pl:table-kind-title kind)) height (cadr group))
                result (append result (list table))
                point (list (car point) (- (cadr point) (* height (+ 6.0 (* 2.8 (max 3 (+ 2 (length (pl:output-table-records kind (cadr group))))))))) (caddr point))))
            (princ (strcat "\n已生成 " (itoa (length result)) " 张关联表，空类别跳过。原总表保留，可移动各表或自行删除总表；规格修改仍会同步。"))))))) result)
(defun pl:table-count-split-work (mode)
  (if (pl:count-work) (pl:output-tables-split nil "PL_表格_苗木" "count" (pl:db-get "LAST_COUNT_SCOPE" '((scope . "model"))) mode)))
(defun pl:table-existing-split-work (/ pick table kind mode)
  (if (setq pick (entsel "\n选择CountingTrees（数树）生成的数量表、名录表或规格表（原表保留）："))
    (progn
      (setq table (car pick) kind (pl:data-get table "TABLE_KIND"))
      (if (not (and (= (cdr (assoc 0 (entget table))) "ACAD_TABLE") (member kind '("count" "list" "specs"))))
        (pl:fail "请选择带植物关联记录的CountingTrees（数树）表格；普通表请先重新统计生成。"))
      (pl:import-area-label-edits)
      (initget "Category Species")
      (setq mode (getkword "\n拆分方式 [三类(Category)/按品种(Species)] <Category>："))
      (pl:output-tables-split table (cdr (assoc 8 (entget table))) kind (pl:data-get table "TABLE_SCOPE")
        (if (equal mode "Species") "species" "category")))))
(defun c:PLANTCADTABLEGROUPS () (pl:run '(lambda () (pl:table-count-split-work "category"))))
(defun c:PLANTCADTABLESPECIES () (pl:run '(lambda () (pl:table-count-split-work "species"))))
(defun c:PLANTCADTABLESPLIT () (pl:run 'pl:table-existing-split-work))
(defun pl:table-edited-plant (p before after / index key value message)
  (setq index 0 message nil)
  (foreach key '(spec_no name kind dbh caliper height crown)
    (if (not (equal (nth index before) (nth index after)))
      (cond
        ((member key '(spec_no name)) (setq p (pl:put key (pl:trim (nth index after)) p)))
        ((= key 'kind) (setq message "类别请在项目规格中修改；表格支持修改名称、编号及尺寸。"))
        (T (setq value (pl:dimension-input key (nth index after) (pl:get 'kind p)))
          (if value (setq p (pl:put key value p)) (setq message "表格规格须填写cm数值、留空或——。")))))
    (setq index (1+ index)))
  (if (not message) (setq message (pl:plant-error p)))
  (if message (pl:fail message) p))
(defun pl:import-table-edits (/ table saved actual before after row index p changed edits pair)
  (foreach table (pl:ss-list (ssget "_X" '((0 . "ACAD_TABLE") (-3 ("PLANTCAD01")))))
    (if (and (pl:data-get table "TABLE_KIND") (setq saved (pl:data-get table "TABLE_ROWS")))
      (progn
        (setq actual (pl:native-table-read (cdr (assoc 5 (entget table)))))
        (if (and (listp actual) (equal (car actual) "TABLE_ROWS"))
          (progn
            (setq index 0)
            (foreach row saved
              (setq before (cadr row) after (nth index (cdr actual)) index (1+ index))
              (if (and after (setq p (pl:by-id (car row))))
                (progn
                  (setq changed (pl:table-edited-plant p before after))
                  (if (not (equal changed p))
                    (progn
                      (if (and (setq pair (assoc (car row) edits)) (not (equal (cadr pair) changed)))
                        (pl:fail "多个表格对同一规格有不同修改，请保留一处修改后再同步。"))
                      (if (not pair) (setq edits (append edits (list (list (car row) changed))))))))))
            ;; Refresh also restores edits to computed columns and deleted rows.
            (if (not (equal (mapcar '(lambda (x) (reverse (cdr (reverse (cadr x))))) saved) (cdr actual)))
              (pl:data-put table "TABLE_ROWS" nil)))))))
  (foreach pair edits (pl:save-project-spec (cadr pair))))
(defun pl:sync-drawing (/ e source role)
  (if (not pl:*sync-busy*)
    (progn
      (setq pl:*sync-busy* T pl:*entity-cache* nil pl:*link-cache* nil pl:*area-value-cache* nil pl:*count-cache* nil)
      (setq pl:*sync-result* (vl-catch-all-apply 'pl:sync-drawing-work nil))
      (setq pl:*sync-busy* nil pl:*entity-cache* nil pl:*link-cache* nil pl:*area-value-cache* nil pl:*count-cache* nil)
      (if (vl-catch-all-error-p pl:*sync-result*) (pl:rethrow pl:*sync-result*))))
  T)
(defun pl:sync-drawing-work (/ e source role point state)
  (pl:import-area-label-edits)
  (pl:upgrade-area-leaders)
  (if (and (boundp 'pl:*native-ui*) pl:*native-ui*) (pl:import-table-edits))
  (foreach e (pl:ss-list (ssget "_X" '((-3 ("PLANTCAD01")))))
    (setq role (pl:role e))
    (if (and (member role '("AREA_LABEL" "AREA_LEADER" "AREA_ARROW" "AREA_FILL" "FILL_EDGE" "LABEL" "LEADER"))
      (not (pl:source e)) (pl:writable e)) (entdel e)))
  (pl:cache-entities)
  (foreach e (pl:all-areas)
    (if (and (pl:data-get e "FILL_HANDLE") (pl:writable e)) (pl:try-fill-area e)))
  (pl:sync-labels)
  (foreach e (pl:all-labels)
    (if (and (equal (pl:role e) "AREA_LABEL") (= (cdr (assoc 0 (entget e))) "MTEXT") (pl:data-get e "OUTPUT_OPTIONS") (pl:writable e))
      (progn
        (setq point (cdr (assoc 10 (entget e)))
          state (list point (cdr (assoc 1 (entget e))) (cdr (assoc 40 (entget e))) (pl:area-label-layer (pl:source e))))
        (if (not (equal state (pl:data-get e "LEADER_STATE"))) (pl:output-leader-shape e)))))
  (pl:ai-refresh-tables))
(defun pl:sync-native () (pl:run 'pl:sync-drawing))
(vl-acad-defun 'pl:sync-native)
(defun c:PLANTCADFILL () (pl:run 'pl:fill-work))
(defun c:PLANTCADBALL () (pl:run 'pl:ball-work))
(defun c:PLANTCADARRANGE () (pl:run 'pl:placement-menu-work))

;;; A read-only dialog does not require redrawing the entire project.
(defun pl:run-needs-sync (fn)
  (and (not (equal fn 'pl:sync-drawing)) pl:*drawing-changed*))
(defun pl:cache-entities (/ all trees areas labels tables project-sources e role source pair)
  (setq all (pl:ss-list (ssget "_X" '((-3 ("PLANTCAD01"))))) pl:*link-cache* nil)
  (foreach e all
    (setq role (pl:role e))
    (cond ((equal role "TREE") (setq trees (cons e trees)))
      ((equal role "AREA") (setq areas (cons e areas)))
      ((equal role "TABLE") (setq tables (cons e tables)))
      ((equal role "PROJECT_SOURCE") (setq project-sources (cons e project-sources))))
    (if (member (cdr (assoc 0 (entget e))) '("MTEXT" "MULTILEADER")) (setq labels (cons e labels)))
    (if (member role '("LABEL" "LEADER"))
      (progn
        (setq source (cdr (assoc 1005 (cdr (pl:xdata e)))) pair (assoc source pl:*link-cache*))
        (if pair (setq pl:*link-cache* (subst (cons source (cons e (cdr pair))) pair pl:*link-cache*))
          (setq pl:*link-cache* (cons (list source e) pl:*link-cache*))))))
  (setq pl:*entity-cache* (list (cons 'all all) (cons 'trees (reverse trees)) (cons 'areas (reverse areas))
    (cons 'labels (reverse labels)) (cons 'tables (reverse tables)) (cons 'project-sources (reverse project-sources)))))
(defun pl:output-counts (scope / cached counts)
  ;; Classification/species filters change table rows, not the source statistics.
  (setq scope (list (cons 'scope (pl:get 'scope scope)) (cons 'handles (pl:get 'handles scope))))
  (if (and pl:*sync-busy* (setq cached (assoc scope pl:*count-cache*))) (cdr cached)
    (progn
      (setq counts (pl:count-rows (pl:output-table-objects scope)))
      (if pl:*sync-busy* (setq pl:*count-cache* (cons (cons scope counts) pl:*count-cache*))) counts)))
(princ)
