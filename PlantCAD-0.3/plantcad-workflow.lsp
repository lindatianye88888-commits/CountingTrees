(defun pl:area-label-text (e / area repaired)
  (if (and (equal (pl:role e) "AREA") (setq area (pl:area-value e)))
    (progn (setq repaired (equal (pl:data-get e "AREA_REPAIRED") 1))
      (strcat (pl:mtext-safe (pl:area-title e)) "\\P" (if repaired "约 " "")
        (pl:area-text area) " 平方米" (if repaired "（补线推定）" ""))) nil))

(defun pl:annotation-units (e / units)
  ;; Plot text follows the current drawing setting; geometry retains its own units.
  (setq units (pl:units))
  (if (not (and (numberp units) (> units 0))) (setq units (pl:data-get e "UNITS")))
  (if (not (and (numberp units) (> units 0))) (pl:fail "请先在设置中确认图纸单位，再刷新标注。")) units)
(defun pl:plot-text-height (e / plot)
  (setq plot (pl:plot-options))
  (pl:paper-height (pl:get 'paper_height plot)
    (if (= (cdr (assoc 67 (entget e))) 1) 1.0 (pl:get 'scale plot)) (pl:annotation-units e)))

(defun pl:create-area-label (e point / text label height)
  (if (and (setq text (pl:area-label-text e)) (not (pl:layer-issue "PL_标注_区域")))
    (progn
      (setq height (pl:plot-text-height e))
      (setq label (pl:make (list '(0 . "MTEXT") '(100 . "AcDbEntity") '(8 . "PL_标注_区域")
          '(62 . 256) '(100 . "AcDbMText") (cons 10 point) (cons 40 height)
          '(41 . 0.0) '(71 . 5) '(72 . 1) (cons 1 text) (cons 7 (getvar "TEXTSTYLE")))))
      (pl:mark label "AREA_LABEL" (cdr (assoc 5 (entget e))))
      (pl:data-put e "AREA_ANCHOR" point) (pl:data-put label "AREA_LABEL_TEXT" text) label)))
(defun pl:area-label-work () (pl:output-area-work))
(defun pl:legacy-area-label-work (/ pick e point)
  (pl:init-layers)
  (if (pl:layer-issue "PL_标注_区域") (pl:fail (pl:layer-issue "PL_标注_区域")))
  (while (setq pick (entsel "\n选择种植范围进行名称与面积标注，回车结束："))
    (setq e (car pick))
    (if (pl:area-label-text e)
      (if (setq point (getpoint "\n标注位置：")) (pl:create-area-label e (trans point 1 0)))
      (princ "\n请选择本插件生成的有效种植范围。"))))

(defun pl:sync-area-labels (/ label source text ed n height actual layer)
  (setq n 0)
  (foreach label (pl:all-labels)
    (if (and (equal (pl:role label) "AREA_LABEL") (pl:writable label)
             (setq source (pl:source label)) (setq text (pl:area-label-text source)))
      (progn
        (if (pl:data-get label "OUTPUT_OPTIONS")
          (setq text (pl:output-area-text source (pl:data-get label "OUTPUT_OPTIONS"))))
        (setq height (pl:area-annotation-height source (pl:data-get label "OUTPUT_OPTIONS"))
          layer (if (pl:data-get label "OUTPUT_OPTIONS") (pl:area-label-layer source) "PL_标注_区域"))
        (cond
          ((= (cdr (assoc 0 (entget label))) "MULTILEADER")
            (setq actual (pl:area-annotation-raw label))
            (if (or (not (equal text actual)) (not (equal layer (cdr (assoc 8 (entget label)))))
                    (not (equal height (pl:data-get label "OUTPUT_HEIGHT")))
                    (not (equal (pl:data-get label "OUTPUT_STYLE_VERSION") 3)))
              (progn
                (pl:write-native-area-label source (pl:data-get label "ANCHOR") '(0.0 0.0 0.0)
                  (pl:data-get label "OUTPUT_OPTIONS") label height)
                (setq n (1+ n)))))
          (T
            (setq ed (pl:set-dxf 40 height (pl:set-dxf 8 layer (pl:set-dxf 1 text (entget label)))))
            (if (not (equal ed (entget label)))
              (if (entmod ed) (progn (entupd label) (setq n (1+ n)))))))
        (if (not (equal text (pl:data-get label "AREA_LABEL_TEXT"))) (pl:data-put label "AREA_LABEL_TEXT" text)))))
  (princ (strcat "\n范围标注刷新 " (itoa n) " 项。")))

(defun pl:detail-work (/ pick e p quantity)
  (if (setq pick (entsel "\n选择植物或种植范围查看属性："))
    (progn
      (setq e (car pick) quantity (pl:quantity-data e))
      (if quantity
        (progn
          (setq p (car quantity))
          (alert (strcat "名称：" (pl:get 'name p) "\n规格：" (pl:get 'spec_no p)
            "\n" (pl:spec-text p) "\n数量：" (pl:num (cadr quantity)) " " (pl:get 'quantity_unit p))))
        (alert "对象没有本插件的有效植物或范围信息。")))))

(defun pl:layer-status-work (/ row issue text)
  (setq text "")
  (foreach row (pl:layers)
    (setq issue (pl:layer-issue (car row))
          text (strcat text (if issue issue (strcat (car row) "：可用")) "\n")))
  (alert (strcat "CountingTrees（数树） 图层状态\n\n" text "\n可在CAD图层管理器中调整。")))

(defun pl:count-all-work (/ rows)
  (setq pl:*count-scope* "Model" rows (pl:count-work))
  (if (or rows (pl:project-pending-records (pl:statistics-model) rows))
    (pl:output-table-create "PL_表格_苗木" "count" "苗木数量总表")))
(defun pl:count-selected-work (/ rows)
