;;; PlantCAD III: floating workbench workflows. Pure geometry comes first.
(defun pl:line-stations (extent spacing closed / result d epsilon)
  (if (and (numberp extent) (numberp spacing) (> extent 0.0) (> spacing 0.0)
           (<= (/ extent spacing) 1999.0))
    (progn
      (setq result nil d 0.0 epsilon (* 1.0e-10 (max 1.0 extent)))
      (while (if closed (< d (- extent epsilon)) (<= d (+ extent epsilon)))
        (setq result (cons (min d extent) result) d (+ d spacing)))
      (reverse result)) nil))

(defun pl:polygon-bounds (points / lo-x lo-y hi-x hi-y pt)
  (setq lo-x (caar points) hi-x lo-x lo-y (cadar points) hi-y lo-y)
  (foreach pt points
    (setq lo-x (min lo-x (car pt)) hi-x (max hi-x (car pt))
          lo-y (min lo-y (cadr pt)) hi-y (max hi-y (cadr pt))))
  (list lo-x lo-y hi-x hi-y))

(defun pl:orient (a b p)
  (- (* (- (car b) (car a)) (- (cadr p) (cadr a)))
     (* (- (cadr b) (cadr a)) (- (car p) (car a)))))

(defun pl:on-segment (p a b / epsilon)
  (setq epsilon (* 1.0e-9 (max 1.0 (abs (- (car b) (car a))) (abs (- (cadr b) (cadr a))))))
  (and (<= (abs (pl:orient a b p)) epsilon)
       (<= (- (min (car a) (car b)) epsilon) (car p))
       (<= (car p) (+ (max (car a) (car b)) epsilon))
       (<= (- (min (cadr a) (cadr b)) epsilon) (cadr p))
       (<= (cadr p) (+ (max (cadr a) (cadr b)) epsilon))))

(defun pl:segments-touch (a b c d / ab-c ab-d cd-a cd-b)
  (setq ab-c (pl:orient a b c) ab-d (pl:orient a b d)
        cd-a (pl:orient c d a) cd-b (pl:orient c d b))
  (or (and (< (* ab-c ab-d) 0.0) (< (* cd-a cd-b) 0.0))
      (pl:on-segment c a b) (pl:on-segment d a b)
      (pl:on-segment a c d) (pl:on-segment b c d)))

(defun pl:polygon-area (points / previous pt sum origin)
  (setq previous (last points) origin (car points) sum 0.0)
  (foreach pt points
    (setq sum (+ sum (pl:orient origin previous pt))
          previous pt))
  (/ (abs sum) 2.0))

(defun pl:simple-polygon (points / n i j good a b)
  (setq n (length points) good (and (>= n 3) (<= n 512) (> (pl:polygon-area points) 1.0e-12)) i 0)
  (while (and good (< i n))
    (setq a (nth i points) b (nth (rem (1+ i) n) points) j (1+ i))
    (if (equal a b 1.0e-9) (setq good nil))
    (while (and good (< j n))
      (if (and (/= j (1+ i)) (not (and (= i 0) (= j (1- n))))
               (pl:segments-touch a b (nth j points) (nth (rem (1+ j) n) points)))
        (setq good nil))
      (setq j (1+ j)))
    (setq i (1+ i))) good)

(defun pl:inside-polygon (point points / previous pt inside boundary y)
  (setq previous (last points) inside nil boundary nil y (cadr point))
  (foreach pt points
    (if (pl:on-segment point previous pt) (setq boundary T))
    (if (or (and (> (cadr pt) y) (<= (cadr previous) y))
            (and (> (cadr previous) y) (<= (cadr pt) y)))
      (if (< (car point) (+ (car pt) (* (- y (cadr pt))
                   (/ (- (car previous) (car pt)) (- (cadr previous) (cadr pt))))))
        (setq inside (not inside))))
    (setq previous pt))
  (or boundary inside))

(defun pl:polygon-grid (points spacing / box x y nx ny out point)
  (if (and (> spacing 0.0) (pl:simple-polygon points))
    (progn
      (setq box (pl:polygon-bounds points)
            nx (1+ (fix (/ (- (nth 2 box) (car box)) spacing)))
            ny (1+ (fix (/ (- (nth 3 box) (cadr box)) spacing))))
      (if (> (* nx ny) 10000) 'limit
        (progn
          (setq y (+ (cadr box) (/ spacing 2.0)) out nil)
          (while (< y (nth 3 box))
            (setq x (+ (car box) (/ spacing 2.0)))
            (while (< x (nth 2 box))
              (setq point (list x y))
              (if (pl:inside-polygon point points) (setq out (cons point out)))
              (setq x (+ x spacing)))
            (setq y (+ y spacing)))
          (reverse out)))) nil))

(defun pl:add-quantity (p quantity rows / key row)
  (setq key (pl:count-key p) row (assoc key rows))
  (if row (subst (list key (cadr row) (+ quantity (caddr row))) row rows)
    (append rows (list (list key p quantity)))))

;;; Host operations. All public workflows execute inside pl:run's single undo mark.
(defun pl:work-plant (/ p issue)
  (pl:init-layers)
  (if (not (pl:current)) (pl:design-start))
  (setq p (pl:current))
  (if p (setq p (pl:resolve-placement p)))
  (if (and p (pl:require-units))
    (progn
      (if (setq issue (pl:insert-error p)) (pl:fail issue))
      (pl:built-blocks)
      (if (setq issue (pl:layer-issue (pl:tree-layer p))) (pl:fail issue)) p) nil))

(defun pl:plant-at (p point / obj e units)
  (setq units (pl:units) obj (pl:insert-symbol p point (pl:block-scale p units))
        e (vlax-vla-object->ename obj))
  (pl:mark e "TREE" nil)
  (pl:data-put e "PLANT" p) (pl:data-put e "UNITS" units)
  (if (not (pl:refresh-symbol e)) (pl:fail "图块文字创建失败，请检查图例。"))
  e)

(defun pl:annotation-plant (e / source p)
  (cond ((setq p (pl:plant e)) p)
    ((equal (pl:role e) "PROJECT_SOURCE") (pl:project-source-plant e))
    ((and (equal (pl:role e) "AREA") (setq p (pl:data-get e "AREA_PLANT"))) p)
    ((and (member (pl:role e) '("LABEL" "LEADER" "AREA_LABEL" "AREA_LEADER" "AREA_ARROW" "AREA_FILL")) (setq source (pl:source e)))
      (if (equal (pl:role source) "AREA") (pl:data-get source "AREA_PLANT") (pl:plant source)))
    (T nil)))

(defun pl:label-plant-matches (lines defs / names specs p line named numbered)
  ;; A specification number disambiguates different sizes of the same species.
  (foreach p defs
    (setq named nil numbered nil)
    (foreach line lines
      (if (equal (pl:normal-name line) (pl:normal-name (pl:get 'name p))) (setq named T))
      (if (and (/= (pl:get 'spec_no p) "") (equal (pl:normal-name line) (pl:normal-name (pl:get 'spec_no p)))) (setq numbered T)))
    (if named (setq names (append names (list p))))
    (if numbered (setq specs (append specs (list p)))))
  (if specs specs names))

(defun pl:plant-from-picked-annotation (e / p lines matches)
  (if (setq p (pl:annotation-plant e)) p
    (if (and (boundp 'pl:*native-ui*) pl:*native-ui*)
      (progn
        (setq lines (pl:native-label-lines (cdr (assoc 5 (entget e))))
          matches (pl:label-plant-matches lines (pl:defs)))
        (if (= (length matches) 1) (car matches)
          (progn
            (alert "此标注未匹配到唯一的项目植物规格。请到“项目规格”选定品种，再用“编辑→已算面积关联当前植物”。普通文字请使用完整植物名称或规格编号；天正自定义对象可能需要先选择其中的文字。") nil))) nil)))

(defun pl:make-current-plant (p)
  (setq p (pl:upgrade-plant p))
  (if (not (equal (pl:by-id (pl:get 'id p)) p)) (setq p (pl:instance-variant p)))
  (pl:save-def p) (pl:db-put "CURRENT" (pl:get 'id p))
  (princ (strcat "\n当前植物：" (pl:get 'name p) " / " (pl:get 'spec_no p))) p)

(defun pl:pick-current-work (/ pick p)
  (if (setq pick (entsel "\n选择已有植物、品种标注或已关联的面积文字："))
    (if (setq p (pl:plant-from-picked-annotation (car pick)))
      (progn (pl:make-current-plant p) T) nil)))

(defun pl:reuse-work () (if (pl:pick-current-work) (pl:insert-work)))

(defun pl:set-style-work (style / p)
  (setq p (pl:current))
  (if (not p) (pl:design-start))
  (if (setq p (pl:current))
    (progn (setq p (pl:put 'style style p)) (pl:save-def p)
      (princ "\n当前图例已切换；已有植物可用“按当前定义批量更新”同步。"))))

(defun pl:circle-work () (pl:set-style-work 0))
(defun pl:simple-work () (pl:set-style-work 1))

(defun pl:block-pick-work (/ p pick ed name issue result)
  (if (not (pl:current)) (pl:design-start))
  (if (and (setq p (pl:current)) (setq pick (entsel "\n选择一个普通图块作为当前植物图例：")))
    (progn
      (setq ed (entget (car pick)) name (cdr (assoc 2 ed)))
      (cond
        ((/= (cdr (assoc 0 ed)) "INSERT") (alert "请选择普通图块参照。"))
        ((or (pl:plant (car pick)) (not name) (= (substr name 1 1) "*")) (alert "请选择不带属性的普通图块，不使用植物包装块或匿名动态块。"))
        ((setq issue (pl:custom-error name)) (alert issue))
        (T
          (setq p (pl:put 'block name (pl:put 'style 2 p)))
          (if (setq result (pl:edit-dialog p))
            (progn (pl:save-def result) (pl:db-put "CURRENT" (pl:get 'id result)))))))))

(defun pl:line-work (/ p pick curve result path-length spacing stations station point n)
  (if (setq p (pl:work-plant))
    (if (setq pick (entsel "\n选择布置路径（直线、圆弧或多段线）："))
      (progn
        (setq curve (car pick) result (vl-catch-all-apply 'vlax-curve-getEndParam (list curve)))
        (if (vl-catch-all-error-p result) (pl:fail "所选对象不是可用的曲线。"))
        (setq path-length (vlax-curve-getDistAtParam curve result))
        (initget 6)
        (if (setq spacing (getreal "\n输入株距 / cm："))
          (progn
            (setq stations (pl:line-stations path-length (* (/ spacing 100.0) (pl:units)) (vlax-curve-isClosed curve)))
            (if (not stations) (pl:fail "路径长度或间距无效，或一次超过2000株；请调整间距或分段布置。"))
            (setq n 0)
            (foreach station stations
              (setq point (vlax-curve-getPointAtDist curve station))
              (pl:plant-at p point) (setq n (1+ n)))
            (princ (strcat "\n沿线布置完成：" (itoa n) " 株；原路径保留。"))))))))

(defun pl:boundary-data (e / ed points pair curved normal elevation)
  (setq ed (entget e) points nil curved nil normal (cdr (assoc 210 ed)))
  (if (and (= (cdr (assoc 0 ed)) "LWPOLYLINE")
           (/= 0 (logand 1 (cdr (assoc 70 ed))))
           (or (not normal) (equal normal '(0.0 0.0 1.0) 1.0e-9)))
    (progn
      (foreach pair ed
        (if (= (car pair) 10) (setq points (cons (cdr pair) points)))
        (if (and (= (car pair) 42) (/= (cdr pair) 0.0)) (setq curved T)))
      (setq points (reverse points) elevation (if (assoc 38 ed) (cdr (assoc 38 ed)) 0.0))
      (if (and (not curved) (pl:simple-polygon points)) (list points elevation) nil)) nil))

(defun pl:pick-boundary (/ pick boundary)
  (if (setq pick (entsel "\n选择闭合直线段轻量多段线边界（保留原线）："))
    (if (setq boundary (pl:boundary-data (car pick))) boundary
      (progn (alert "需要无自交的闭合二维轻量多段线，最多512个顶点。本版边界暂不接受圆弧段、孔洞或倾斜平面。") nil))))

(defun pl:grid-work (/ p boundary spacing points point n)
  (if (and (setq p (pl:work-plant)) (setq boundary (pl:pick-boundary)))
    (progn
      (initget 6)
      (if (setq spacing (getreal "\n网格横向与纵向间距 / cm："))
        (progn
          (setq points (pl:polygon-grid (car boundary) (* (/ spacing 100.0) (pl:units))))
          (cond
            ((eq points 'limit) (pl:fail "网格候选点超过10000个，请增大间距或分区布置。"))
            ((not points) (alert "该间距下边界内没有网格点，请减小间距。"))
            (T
              (setq n 0)
              (foreach point points
                (pl:plant-at p (list (car point) (cadr point) (cadr boundary)))
                (setq n (1+ n)))
              (princ (strcat "\n区域布置完成：" (itoa n) " 株；原边界保留。")))))))))

(defun pl:area-number (e / no)
  (setq no (pl:data-get e "AREA_NO"))
  (if no no (strcat "A" (cdr (assoc 5 (entget e))))))
(defun pl:area-title (e / p)
  (if (setq p (pl:data-get e "AREA_PLANT")) (pl:get 'name p)
    (strcat "区域 " (pl:area-number e))))
(defun pl:register-geometric-area (e kind / sequence)
  ;; Geometry is valid without a species. Never inherit the current plant implicitly.
  (setq sequence (1+ (pl:db-get "AREA_SEQUENCE" 0)))
  (pl:db-put "AREA_SEQUENCE" sequence)
  (pl:mark e "AREA" nil)
  (pl:data-put e "AREA_NO" (strcat "A" (itoa sequence)))
  (pl:data-put e "AREA_KIND" kind)
  (pl:data-put e "UNITS" (pl:units)) e)
(defun pl:consume-area-row (row kind / e point fresh radius label text ed)
  (if (and (setq e (handent (car row))) (entget e) (setq point (pl:point-value (cadr row))))
    (progn
      (setq fresh (not (pl:data-get e "AREA_NO")))
      (if fresh
        (progn (pl:register-geometric-area e kind) (pl:data-put e "AREA_REPAIRED" (nth 2 row))))
      (if (equal (nth 4 row) 1) (pl:data-put e "AREA_FITTED" 1))
      (setq radius (nth 3 row))
      (pl:data-put e "AREA_LABEL_RADIUS" radius)
      (setq label (cdr (assoc e pl:*measure-labels*)))
      (if (and label (entget label))
        (progn
          (if (not (pl:writable label)) (pl:fail "已有面积文字图层锁定，未移动或覆盖。"))
          (setq text (pl:area-label-text e) ed (pl:set-dxf 10 point (pl:set-dxf 1 text (entget label))))
          (if (not (equal ed (entget label))) (if (entmod ed) (entupd label) (pl:fail "面积文字更新失败。")))
          "KEPT")
        (if (setq label (pl:create-area-label e point))
          (progn (setq pl:*measure-labels* (cons (cons e label) pl:*measure-labels*)) "CREATED")
          (pl:fail "区域已登记，但面积文字未生成，请检查面积值和标注图层。"))))
    (pl:fail "区域返回了无效句柄或区内标注点。")))
(defun pl:consume-area-batch (result kind / row label source answer previous created kept failed n)
  (if (not (and (listp result) (equal (car result) "AREA_BATCH")))
    (pl:fail (if (= (type (pl:native-value result)) 'STR) (pl:native-value result) "自动面积返回格式无效。")))
  (setq pl:*measure-labels* nil created 0 kept 0 failed 0 n 0)
  (foreach label (pl:all-labels)
    (if (and (= (cdr (assoc 0 (entget label))) "MTEXT") (equal (pl:role label) "AREA_LABEL")
      (not (pl:data-get label "OUTPUT_OPTIONS")) (setq source (pl:source label)))
      (setq pl:*measure-labels* (cons (cons source label) pl:*measure-labels*))))
  (foreach row (cdr result)
    (setq previous pl:*failure* pl:*failure* nil
      answer (vl-catch-all-apply 'pl:consume-area-row (list row kind)))
    (if (vl-catch-all-error-p answer)
      (progn (setq failed (1+ failed))
        (princ (strcat "\n区域 " (car row) " 面积文字未完成："
          (if pl:*failure* pl:*failure* (vl-catch-all-error-message answer)) "；可用“手动补面积”处理。")))
      (progn (setq n (1+ n))
        (if (equal answer "CREATED") (setq created (1+ created)) (setq kept (1+ kept)))))
    (setq pl:*failure* previous))
  (setq pl:*measure-labels* nil)
  (princ (strcat "\n已检查 " (itoa n) " 个区域；新增面积文字 " (itoa created)
    " 个；保留/更新已有文字 " (itoa kept) " 个；未完成 " (itoa failed) " 个。")) n)
(defun pl:range-session-loop (/ result layer)
  (setq layer (cond ((= pl:*range-kind* 1) "PL_灌木_计算边界")
    ((= pl:*range-kind* 2) "PL_草地_边界") (T "PL_面积_计算边界")))
  (if (pl:layer-issue layer) (pl:fail (pl:layer-issue layer)))
  (if (pl:layer-issue "PL_标注_区域") (pl:fail (pl:layer-issue "PL_标注_区域")))
  (setq result (pl:native-area-export-all layer))
  (pl:consume-area-batch result pl:*range-kind*))

(defun pl:manual-area-work (/ mode pick entity selection handles result)
  (if (not (and (boundp 'pl:*native-ui*) pl:*native-ui*)) (pl:fail "手动补面积需要配套原生插件。"))
  (if (pl:require-units)
    (progn
      (pl:init-layers)
      (if (pl:layer-issue "PL_面积_计算边界") (pl:fail (pl:layer-issue "PL_面积_计算边界")))
      (if (pl:layer-issue "PL_标注_区域") (pl:fail (pl:layer-issue "PL_标注_区域")))
      (initget "Boundary Edges")
      (setq mode (getkword "\n手动补面积 [点闭合边界(Boundary)/框选组成边线(Edges)] <Boundary>："))
      (cond
        ((equal mode "Edges")
          (princ "\n框选组成围合的全部边线，可跨图层；只计算实际闭合，不猜测补线。")
          (setq selection (ssget '((0 . "LINE,ARC,LWPOLYLINE,POLYLINE,SPLINE,CIRCLE,ELLIPSE"))))
          (foreach entity (pl:ss-list selection) (setq handles (cons (cdr (assoc 5 (entget entity))) handles)))
          (if handles (pl:consume-area-batch (pl:native-area-manual (reverse handles) "PL_面积_计算边界") -1)))
        (T
          (while (setq pick (entsel "\n点选闭合多段线、圆、椭圆或计算面域（回车结束）："))
            (setq entity (or (pl:area-from-selection (car pick)) (car pick))
              result (pl:native-area-manual (list (cdr (assoc 5 (entget entity)))) "PL_面积_计算边界"))
            (if (and (listp result) (equal (car result) "AREA_BATCH")) (pl:consume-area-batch result -1)
              (princ (strcat "\n" (pl:native-value result) "；散线请用框选组成边线方式。")))))))))
(defun pl:area-selection (/ filter selection handles index)
  (setq pl:*stage* "选择面积边界"
    filter '((0 . "LINE,ARC,LWPOLYLINE,POLYLINE,SPLINE,CIRCLE,ELLIPSE")))
  (setq selection (ssget "_I" filter))
  (if (not selection)
    (progn
      (princ "\n框选灌木边线，框选完成后按回车开始计算；Esc 取消。其他图层可以保持显示。")
      (setq selection (ssget filter))))
  (if selection
    (progn
      (setq handles nil index 0)
      (repeat (sslength selection)
        (setq handles (cons (cdr (assoc 5 (entget (ssname selection index)))) handles) index (1+ index)))
      (sssetfirst nil nil)
      (reverse handles))
    (progn (princ "\n未选择边界，面积识别已取消。") nil)))

(defun pl:area-prepare (handles / count picked layer)
  (setq pl:*stage* "计算边线围合面积"
    count (pl:native-value (pl:native-area-begin handles "")))
  (if (equal count "AREA_PICK_LAYER")
    (progn
      (setq pl:*stage* "确认灌木边线图层"
        picked (entsel "\n点选框选范围内的一条灌木边线确认图层（Esc 取消）："))
      (if picked
        (progn
          (setq layer (cdr (assoc 8 (entget (car picked)))) pl:*stage* "计算边线围合面积"
            count (pl:native-value (pl:native-area-begin handles layer))))
        (setq count nil))))
  (if (= (type count) 'STR) (pl:fail count)) count)

(defun pl:geometry-session-work (/ handles count total)
  ;; Finish native CAD selection before invoking geometry. Units convert only after calculation.
  (if (and (setq handles (pl:area-selection)) (setq count (pl:area-prepare handles)))
    (if (and (numberp count) (> count 0) (pl:require-units))
      (progn
        (setq pl:*stage* "生成区域和面积标注")
        (pl:init-layers)
        (setq total (pl:native-value (pl:native-area-total)))
        (if (numberp total) (princ (strcat "\n候选闭合区域合计：" (rtos (/ total (* (pl:units) (pl:units))) 2 2)
          " 平方米；按原线及推定连接计算，带约数的区域需核对。")))
        (pl:range-session-loop)))))
(defun pl:range-work (kind / result)
  (if (not (and (boundp 'pl:*native-ui*) pl:*native-ui*))
    (alert "曲线几何面积需要配套的CountingTrees（数树）原生插件。请从CAD中的CountingTrees（数树）浮窗打开。")
    (progn
      (setq pl:*range-kind* kind)
      (setq result (vl-catch-all-apply 'pl:geometry-session-work nil))
      (vl-catch-all-apply 'pl:native-area-end nil) (setq pl:*range-kind* nil)
      (if (vl-catch-all-error-p result) (pl:rethrow result)))))

(defun pl:geometry-area-work () (pl:range-work -1))
(defun pl:shrub-work () (pl:range-work 1))
(defun pl:ground-work () (pl:range-work 2))

(defun pl:area-value (e / cached value)
  (if (and pl:*sync-busy* (setq cached (assoc e pl:*area-value-cache*))) (cdr cached)
    (progn
      (setq value (pl:uncached-area-value e))
      (if pl:*sync-busy* (setq pl:*area-value-cache* (cons (cons e value) pl:*area-value-cache*))) value)))
(defun pl:uncached-area-value (e / obj units result valid)
  (if (and (equal (pl:role e) "AREA") (setq units (pl:data-get e "UNITS")) (> units 0.0))
    (progn
      (if (and (boundp 'pl:*native-ui*) pl:*native-ui*)
        (setq result (pl:native-value (pl:native-area-value (cdr (assoc 5 (entget e))))))
        (progn
          (setq obj (vlax-ename->vla-object e)
            valid (or (= (cdr (assoc 0 (entget e))) "REGION")
              (and (= (cdr (assoc 0 (entget e))) "LWPOLYLINE") (= (vla-get-Closed obj) :vlax-true))))
          (if valid (setq result (vl-catch-all-apply 'vla-get-Area (list obj))))))
      (if (and (not (vl-catch-all-error-p result)) (numberp result) (> result 0.0))
        (/ result (* units units)) nil)) nil))

(defun pl:area-quantity-definition (e / p kind)
  (setq p (pl:data-get e "AREA_PLANT"))
  (if (not p)
    (progn
      ;; This is a table view of an unassigned area, never a saved plant definition.
      (setq kind (pl:data-get e "AREA_KIND")
        p (pl:empty-plant (strcat "GEOMETRY_" (cdr (assoc 5 (entget e))))))
      (setq p (pl:put 'name "未关联植物" (pl:put 'spec_no (pl:area-number e)
        (pl:put 'kind (if (member kind '(1 2)) kind 1) p))))))
  (pl:put 'quantity_unit "平方米" p))
(defun pl:quantity-data (e / p area)
  (cond
    ((setq p (pl:plant e)) (list p 1))
    ((and (equal (pl:role e) "PROJECT_SOURCE") (setq p (pl:project-source-plant e))
      (setq area (pl:data-get e "PROJECT_COUNT")) (numberp area) (> area 0)) (list p area))
    ((and (equal (pl:role e) "AREA") (setq area (pl:area-value e)))
      (list (pl:area-quantity-definition e) area))
    (T nil)))

(defun pl:bind-area-plant (e p / previous result)
  (if (and p (equal (pl:role e) "AREA") (pl:writable e) (pl:area-value e))
    (progn
      (setq previous (pl:data-get e "AREA_PLANT"))
      (pl:data-put e "AREA_PLANT" p)
      (if (and (boundp 'pl:*native-ui*) pl:*native-ui*)
        (progn
          (setq result (vl-catch-all-apply 'pl:fill-area (list e)))
          (if (vl-catch-all-error-p result)
            (progn (pl:data-put e "AREA_PLANT" previous) (pl:rethrow result))))) T) nil))
(defun pl:area-from-selection (e)
  (cond ((equal (pl:role e) "AREA") e)
    ((member (pl:role e) '("AREA_LABEL" "AREA_LEADER" "AREA_ARROW" "AREA_FILL")) (pl:source e)) (T nil)))

(defun pl:bind-selected-areas (p / item e seen n skipped selection filter)
  (princ (strcat "\n选择计算边界或面积文字，关联为：" (pl:get 'name p) "；可多选，回车确认。"))
  (setq n 0 skipped 0 seen nil filter '((-3 ("PLANTCAD01")))
    selection (ssget "_I" filter))
  (if (not selection) (setq selection (ssget filter)))
  (sssetfirst nil nil)
  (foreach item (pl:ss-list selection)
    (if (and (setq e (pl:area-from-selection item)) (not (member e seen)))
      (progn
        (setq seen (cons e seen))
        (if (pl:bind-area-plant e p) (setq n (1+ n)) (setq skipped (1+ skipped))))))
  (if (> n 0) (progn (pl:sync-area-labels) (pl:ai-refresh-tables)))
  (princ (strcat "\n已关联 " (itoa n) " 个区域；锁定或无效区域跳过 " (itoa skipped) " 个。名称及面积标注和统计已更新。")))

(defun pl:area-bind-work (/ p)
  (if (not (pl:current)) (pl:library-work))
  (if (setq p (pl:current)) (pl:bind-selected-areas p)))

(defun pl:area-bind-label-work (/ pick p)
  (if (setq pick (entsel "\n选择已有灌木品种标注（植物图块、名称文字或引线）："))
    (if (setq p (pl:plant-from-picked-annotation (car pick)))
      (progn (pl:make-current-plant p) (pl:bind-selected-areas p)))))

(defun pl:all-areas (/ e result)
  (if (assoc 'areas pl:*entity-cache*) (cdr (assoc 'areas pl:*entity-cache*))
  (progn
  (foreach e (pl:ss-list (ssget "_X" '((0 . "LWPOLYLINE,REGION") (-3 ("PLANTCAD01")))))
    (if (equal (pl:role e) "AREA") (setq result (cons e result))))
  (reverse result))))

(defun pl:statistics-model (/ e result)
  (foreach e (append (pl:all-trees) (pl:all-areas) (pl:all-project-sources))
    (if (not (equal 1 (cdr (assoc 67 (entget e))))) (setq result (cons e result))))
  (reverse result))

(defun pl:statistics-select (/ e item result)
  (princ "\n选择或框选植物及种植范围：")
  (foreach item (pl:ss-list (ssget '((-3 ("PLANTCAD01")))))
    (if (and (setq e (pl:project-source item)) (not (member e result))
      (or (pl:quantity-data e) (equal (pl:role e) "PROJECT_SOURCE"))) (setq result (cons e result))))
  (reverse result))

(defun pl:replace-work (/ p targets e n skipped)
  (if (setq p (pl:work-plant))
    (progn
      (princ (strcat "\n将所选植物替换为：" (pl:get 'name p) " / " (pl:get 'spec_no p)))
      (setq targets (pl:select-trees) n 0 skipped 0)
      (foreach e targets
        (if (pl:apply-plant e p) (setq n (1+ n)) (setq skipped (1+ skipped))))
      (pl:sync-labels)
      (princ (strcat "\n替换完成：" (itoa n) " 株；锁定或无效对象跳过 " (itoa skipped) " 株。")))))

(defun pl:label-preset (mode leader / opts)
  (setq opts (pl:db-get "LABEL_OPTIONS" '((mode . 0) (prefix . 0) (units . 0) (leader . 0))))
  (setq opts (pl:put 'mode mode (pl:put 'leader leader opts)))
  (if (not (pl:get 'height opts))
    (progn
      (if (not (pl:require-units)) (pl:fail "图纸单位未确认。"))
      (setq opts (pl:put 'height (pl:paper-height (pl:get 'paper_height (pl:plot-options))
        (pl:get 'scale (pl:plot-options)) (pl:units)) opts))))
  (pl:db-put "LABEL_OPTIONS" opts)
  (pl:label-work))

