;;; Reserve past specification numbers so existing snapshots keep unambiguous IDs.
(defun pl:used-specs () (append (pl:defs) (pl:db-get "SPEC_HISTORY" nil)))
(defun pl:history-error (p / previous row no)
  (setq no (strcase (pl:get 'spec_no p)) previous nil)
  (foreach row (pl:db-get "SPEC_HISTORY" nil)
    (if (= no (strcase (pl:get 'spec_no row))) (setq previous row)))
  (if (and previous (not (equal (pl:physical-key p) (pl:physical-key previous))))
    "这个编号已用于其他真实规格，请使用新编号。" nil))
(defun pl:remember-spec (p / history row old msg)
  (setq history (pl:db-get "SPEC_HISTORY" nil) old nil)
  (if (setq msg (pl:history-error p)) (pl:fail msg))
  (foreach row history
    (if (= (strcase (pl:get 'spec_no row)) (strcase (pl:get 'spec_no p))) (setq old row)))
  (if (not old) (pl:db-put "SPEC_HISTORY" (append history (list p)))) p)
(defun pl:prepare-edited-spec (p old defs)
  ;; The old argument is the dialog snapshot; fresh variants start with a fresh ID.
  (if (and (pl:get 'spec_no old) (/= (pl:get 'spec_no old) "")
           (= (strcase (pl:get 'spec_no p)) (strcase (pl:get 'spec_no old)))
           (not (equal (pl:physical-key p) (pl:physical-key old)))
           (pl:by-id (pl:get 'id p)))
    (setq p (pl:put 'id (pl:new-id) (pl:put 'spec_no (pl:next-spec-number defs) p)))) p)

;;; Optional visual sample; invoked by the designer only in an empty model.
(defun pl:demo-insert (p point / units scale obj e)
  (setq units 1000.0 scale (pl:block-scale p units))
  (setq obj (vla-InsertBlock (vla-get-ModelSpace (pl:doc)) (vlax-3d-point point)
    (pl:block-name p) scale scale scale 0.0))
  (vla-put-Layer obj (pl:tree-layer p)) (vla-put-Color obj 256)
  (setq e (vlax-vla-object->ename obj))
  (pl:mark e "TREE" nil) (pl:data-put e "PLANT" p) (pl:data-put e "UNITS" units)
  (if (not (pl:refresh-symbol e)) (pl:fail "示例图块缺少文字属性。")) e)
(defun pl:demo-work (/ p q r)
  (if (or (> (vla-get-Count (vla-get-ModelSpace (pl:doc))) 0) (pl:defs))
    (pl:fail "PLDEMO只用于新建空白图，请先另建空白图再运行。"))
  (pl:init-layers) (pl:built-blocks) (pl:db-put "UNIT" 0)
  (pl:db-put "PLOT_OPTIONS" '((scale . 100.0) (paper_height . 2.5) (show_number . 0)))
  (setq p (pl:new-spec nil) p (pl:put 'name "银杏" p)
    p (pl:put 'dbh 12.0 p) p (pl:put 'height 4.0 p) p (pl:put 'crown 3.0 p))
  (pl:save-def p)
  (setq q (pl:put 'id (pl:new-id) p) q (pl:put 'spec_no (pl:next-spec-number (pl:used-specs)) q)
    q (pl:put 'dbh 18.0 q) q (pl:put 'height 5.0 q) q (pl:put 'crown 5.0 q))
  (pl:save-def q)
  (setq r (pl:new-spec nil) r (pl:put 'name "桂花" r)
    r (pl:put 'caliper 8.0 r) r (pl:put 'diameter_mode 1 r)
    r (pl:put 'height 3.0 r) r (pl:put 'crown 3.0 r) r (pl:put 'style 1 r))
  (pl:save-def r)
  (pl:demo-insert p '(0.0 0.0 0.0))
  (pl:demo-insert q '(7000.0 0.0 0.0))
  (pl:demo-insert r '(14000.0 0.0 0.0))
  (pl:db-put "CURRENT" (pl:get 'id p))
  (if (= (vla-get-Visible (vlax-get-acad-object)) :vlax-true)
    (vla-ZoomExtents (vlax-get-acad-object)))
  (princ "\n已生成3个示例：银杏D12/P3、银杏D18/P5、桂花地径8/P3。")
  (princ "\n字高250mm，按1:100出图为2.5mm。用PLINFO查看编号，PLSET改比例，PLTABLE生成规格表。"))
(defun c:PLANTCADDEMO () (pl:run 'pl:demo-work))

;;; Dedicated tables for selected plants and project specifications.
(defun pl:design-table-work (layer title headers rows)
  (pl:output-table-create layer (if (= layer "PL_表格_植物名录") "list" "specs") title))
(defun pl:legacy-design-table-work (layer title headers rows / opts scale height defaultheight point table row value col i)
  (pl:init-layers)
  (if (not (pl:layer-open layer)) (pl:fail "目标表格图层已锁定，请先解锁。"))
  (if (not rows) (princ "\n请先用PLDESIGN选择植物并建立项目规格。")
    (if (pl:require-units)
      (progn
        (setq opts (pl:db-get "PLOT_OPTIONS" '((scale . 100.0))))
        (setq scale (if (and (= (getvar "TILEMODE") 0) (= (getvar "CVPORT") 1))
                      1.0 (pl:get 'scale opts)))
        (setq defaultheight (pl:paper-height 2.5 scale (pl:units)))
        (initget 6)
        (setq height (getreal (strcat "\n表格字高 / cm <" (pl:num (/ (* defaultheight 100.0) (pl:units))) ">：")))
        (if height (setq height (* (/ height 100.0) (pl:units))) (setq height defaultheight))
        (if (setq point (getpoint (strcat "\n" title "插入点：")))
          (progn
            (setq table (vla-AddTable (pl:space) (vlax-3d-point (trans point 1 0))
              (+ 2 (length rows)) (length headers) (* 2 height) (* 16 height)))
            (vla-put-Layer table layer)
            (vla-SetTextHeight table 7 height)
            (vla-SetTextStyle table 7 (getvar "TEXTSTYLE"))
            (vla-SetText table 0 0 title)
            (setq col 0)
            (foreach value headers
              (vla-SetText table 1 col value) (setq col (1+ col)))
            (setq i 2)
            (foreach row rows
              (setq col 0)
              (foreach value row
                (vla-SetText table i col value) (setq col (1+ col)))
              (setq i (1+ i)))
            (pl:mark (vlax-vla-object->ename table) "TABLE" nil)
            (princ (strcat "\n已在 " layer " 生成表格快照，植物或规格修改后请重新生成。"))))))))
(defun pl:list-table-work ()
  (pl:design-table-work "PL_表格_植物名录" "植物名录表（项目选定品种）"
    '("序号" "植物名称" "形态分类" "参考地区")
    (pl:plant-list-rows (pl:ai-visible-defs) (pl:catalog))))
(defun pl:spec-table-work ()
  (pl:design-table-work "PL_表格_植物规格" "植物规格表（项目定义）"
    '("规格编号" "植物名称" "类别" "胸径 cm" "地径 cm" "高度 cm" "冠幅 cm" "单位")
    (pl:spec-list-rows (pl:ai-visible-defs))))
(defun c:PLANTCADLISTTABLE () (pl:run 'pl:list-table-work))
(defun c:PLANTCADSPECTABLE () (pl:run 'pl:spec-table-work))

