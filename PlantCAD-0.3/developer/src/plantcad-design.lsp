(defun pl:remember-size (p / defaults old values key)
  (setq defaults (pl:db-get "SIZE_DEFAULTS" nil) values nil)
  (foreach key '(crown height dbh caliper diameter_mode)
    (setq values (append values (list (cons key (pl:get key p))))))
  (setq old (assoc (pl:size-key p) defaults))
  (pl:db-put "SIZE_DEFAULTS" (if old (subst (cons (pl:size-key p) values) old defaults)
    (append defaults (list (cons (pl:size-key p) values))))))

(defun pl:project-columns ()
  (strcat "分类\t编号\t植物名称\t高度H/cm\t冠幅P/cm\t胸径D/cm\t地径d/cm\t单位"))
(defun pl:project-list-row (p)
  (strcat (pl:kind-name (pl:get 'kind p)) "\t" (pl:get 'spec_no p) "\t" (pl:get 'name p)
    "\t" (pl:dimension-text 'height p) "\t" (pl:dimension-text 'crown p)
    "\t" (pl:dimension-text 'dbh p) "\t" (pl:dimension-text 'caliper p) "\t" (pl:get 'quantity_unit p)))
(defun pl:project-filter-dialog (/ row key)
  (setq pl:*project-visible* (pl:project-filter (pl:defs) (1- (atoi (get_tile "project_kind"))) (get_tile "project_query")))
  (start_list "project_columns") (add_list (pl:project-columns)) (end_list)
  (start_list "plants")
  (foreach row pl:*project-visible*
    (add_list (pl:project-list-row row)))
  (end_list) (setq pl:*index* 0)
  (foreach key '("edit" "clone" "update" "accept" "place") (mode_tile key (if pl:*project-visible* 0 1)))
  (if pl:*project-visible* (set_tile "plants" "0")))
(defun pl:calibrate-work (/ first second actual units)
  (princ "\n选底图上已知真实长度的两点；例如标注为500cm的边，不用文字高度推断单位。")
  (if (and (setq first (getpoint "\n校准起点：")) (setq second (getpoint first "\n校准终点：")))
    (progn
      (initget 6) (setq actual (getreal "\n这段距离的真实长度 / cm："))
      (if (setq units (pl:calibrated-units (distance first second) actual))
        (progn (pl:db-put "UNITS_PER_M" units) (pl:db-put "UNIT" 3)
          (princ (strcat "\n已校准：1米=" (pl:num units) "图纸单位。应用于接下来布置和识别的区域；已有对象保留其原单位记录。")))
        (princ "\n校准未完成，原单位设置保留。")))))
(defun pl:save-info-work ()
  (alert (strcat "植物品种、项目规格、待选清单和尺寸记忆保存在DWG图纸内部。\n"
    "图中植物和面积对象另外保存各自的规格、单位和关联标注。\n\n"
    (if (= (getvar "DWGTITLED") 1) (strcat "保存文件：" (getvar "DWGPREFIX") (getvar "DWGNAME"))
      "当前图纸尚未命名，请先另存为DWG。")
    "\n\n点击“保存项目到当前DWG”或按CAD原生Ctrl+S。仅关闭植物浮窗不会清除项目。")))
(defun pl:save-project-work ()
  (if (= (getvar "DWGTITLED") 1) (progn (vla-Save (pl:doc)) (princ "\n项目植物信息已随当前DWG保存。"))
    (command "_.QSAVE")))
(defun c:PLANTCADCALIBRATE () (pl:run 'pl:calibrate-work))
(defun c:PLANTCADSAVEINFO () (pl:save-info-work) (princ))
(defun c:PLANTCADSAVE () (pl:save-project-work) (princ))

(defun pl:project-size-defaults (/ defaults p values key)
  (setq defaults (pl:db-get "SIZE_DEFAULTS" nil))
  (foreach p (pl:defs)
    (if (not (assoc (pl:size-key p) defaults))
      (progn (setq values nil)
        (foreach key '(crown height dbh caliper diameter_mode) (setq values (append values (list (cons key (pl:get key p))))))
        (setq defaults (append defaults (list (cons (pl:size-key p) values))))))) defaults)
