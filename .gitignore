# Publish only the software, documentation and distributable package.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/开始使用.md
!/PlantCAD-0.3/
!/PlantCAD-0.3.23-CAD2014-TArch9/
!/releases/

# Machine state, generated client paths and private CAD test evidence.
**/__pycache__/
**/*.py[cod]
**/install-state.json
**/queue-root.json
**/bridge/clients/
**/bridge/runtime/
**/bridge/host-output/
**/developer/bin/
**/developer/backups/
**/developer/fixtures/
**/developer/reports/
**/*verification.json

# Credentials and third-party SDK/reference binaries are never distributed.
**/.env
**/.env.*
**/*.pem
**/*.key
**/acmgd.dll
**/acdbmgd.dll
**/accoremgd.dll
**/*.nupkg
**/*.fas
**/*.dwg
**/*.dxf
**/*.bak
**/*.ac$
**/*.dwl
**/*.dwl2
